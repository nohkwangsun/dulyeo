{
  "name": "dulyeo",
  "version": "0.2.0",
  "description": "Standalone Android/PWA app: turn English scripts (markdown) into mp3 on the phone and listen hands-free with repeat, gaps and speed control.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "android:setup": "node scripts/setup-android.mjs",
    "android:sync": "vite build && cap sync android"
  },
  "engines": { "node": ">=20.19" },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@jofr/capacitor-media-session": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "vite": "^7.0.0"
  }
}
